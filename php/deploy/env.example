# Réglages du serveur TripVision (version PHP).
# Copiez ce fichier sous le nom « .env » DANS LE DOSSIER « app » et remplissez-le. Ne le partagez jamais, ne le mettez jamais dans Git.

# Base de données MariaDB / MySQL de l'hébergement Nuxit (panneau Nuxit → Bases de données).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Clé de signature des connexions : une longue chaîne aléatoire (la MÊME que sur Render tant que les deux versions tournent, sinon tout le monde est déconnecté une fois).
JWT_SECRET=

# Adresse publique du site, sans « / » final (utilisée dans les e-mails et pour le retour de paiement).
APP_URL=https://www.exemple.fr

CORS_ORIGIN=

# Adresse qui reçoit les alertes de l'équipe (nouvelles demandes, messages…).
SUPPORT_EMAIL=hello@tripvision.fr

# E-mails. Choisir UNE option :
#  1) SMTP du compte mail Nuxit (ou autre) :
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TripVision <noreply@tripvision.fr>
#  2) ou l'API Brevo :
BREVO_API_KEY=
#  3) ou la fonction mail() de l'hébergeur (mettre 1) :
MAIL_NATIVE=

# Paiement en ligne Stripe (clé « sk_test_… » pour tester, « sk_live_… » pour de vrais paiements). Vide = paiement désactivé.
STRIPE_SECRET_KEY=
# Secret de signature du webhook Stripe (whsec_…) : endpoint https://VOTRE-SITE/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Tâches planifiées (CRON) : une longue chaîne aléatoire. Le CRON appelle https://VOTRE-SITE/api/cron/run?key=CETTE_CHAINE
CRON_KEY=

# Mettre 1 si le site est derrière un relais qui transmet la vraie adresse IP du visiteur (X-Forwarded-For).
TRUST_PROXY=0
