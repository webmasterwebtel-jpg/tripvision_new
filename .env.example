# Connexion Postgres (Supabase ou autre). Depuis Supabase : Project Settings > Database > Connection string > URI.
# En prod, préfère le "connection pooling" (port 6543) ; en local/dev, le port 5432 direct fonctionne aussi.
DATABASE_URL=postgres://user:password@localhost:5432/tripvision

# Secret de signature des JWT (chaîne aléatoire longue, jamais commitée)
JWT_SECRET=change-me-to-a-long-random-string

CORS_ORIGIN=*
PORT=3000

# Mots de passe des comptes créés par le seed initial (phase 1 uniquement).
# Change-les après la première connexion : must_change_password forcera le renouvellement.
IT_PASSWORD=change-me-it-password
ADMIN_PASSWORD=change-me-admin-password
MANAGER_PASSWORD=change-me-manager-password

PARTNER_PASSWORD=change-me-partner-password

# Envoi d'e-mails (liens d'activation et de réinitialisation) : SMTP Nuxit
SMTP_HOST=smtp.webmo.fr
SMTP_PORT=587
SMTP_USER=no-reply@votre-domaine.fr
SMTP_PASSWORD=change-me
SMTP_FROM=TripVision <no-reply@votre-domaine.fr>
# URL publique de l'application (utilisée dans les liens des e-mails)
APP_URL=http://localhost:3000

# Paiement en ligne (Stripe, mode test : cle commencant par sk_test_). Laisser vide pour desactiver le paiement.
STRIPE_SECRET_KEY=
# Facultatif mais recommande : secret de signature du webhook (whsec_...), endpoint /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
